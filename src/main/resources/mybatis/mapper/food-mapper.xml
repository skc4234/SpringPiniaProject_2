<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sist.web.mapper.FoodMapper">
	<!-- 
		resultType    : 리턴형
		parameterType : 매개변수 데이터형
		id            : 메소드명
		
		XML : SQL 문장이 복잡한 경우에 사용(JOIN / 동적 쿼리)
		@Select / @Insert / @Update / @Delete : 단순한 SQL 문장에 사용
	 -->
	 <!-- 목록 출력 -->
	<select id="foodListData" resultType="com.sist.web.vo.FoodVO"
			parameterType="int">
		SELECT no,name,address,poster
		FROM food
		ORDER BY no DESC
		OFFSET #{start} ROWS FETCH NEXT 12 ROWS ONLY		
	</select>

</mapper>